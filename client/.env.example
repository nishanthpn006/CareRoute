VITE_API_BASE_URL=http://localhost:4000
VITE_DATA_MODE=demo

# Required only when VITE_DATA_MODE=firebase. Use your Firebase Web App config.
VITE_FIREBASE_API_KEY=your-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_APP_ID=your-web-app-id

# OpenStreetMap raster tiles & OSRM road routing (free public service demo defaults)
VITE_OSM_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_OSRM_BASE_URL=https://router.project-osrm.org

# Development-only emergency SOS test telephone number (e.g. +919876543210).
# When configured and running in development mode (import.meta.env.DEV), the header
# SOS test action connects to this number for testing telephone links without calling
# official emergency responders. Disabled automatically in production builds.
VITE_SOS_TEST_NUMBER=

