PORT=4000
DATA_MODE=demo
CORS_ORIGIN=http://localhost:5173

# Demo Authentication Gating:
# In production, demo login is disabled by default (returning 404).
# For local evaluation or development only, set ENABLE_DEMO_LOGIN=true to enable /api/auth/demo-login:
ENABLE_DEMO_LOGIN=false

# JWT signing secret (required in all modes, minimum 32 characters):
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# Demo mode credentials (used when ENABLE_DEMO_LOGIN=true):
DEMO_ADMIN_EMAIL=admin@careroute.local
DEMO_ADMIN_PASSWORD=replace-with-your-local-demo-password

# PostgreSQL mode (primary persistent storage)
# DATA_MODE=postgres
# DATABASE_URL=postgresql://careroute_app:your_password@localhost:5432/careroute_dev
#
# PostgreSQL Managed Cloud Database SSL (AWS RDS, Supabase, Render, Neon):
# DATABASE_SSL=true
# DATABASE_SSL_REJECT_UNAUTHORIZED=true
# Optional CA certificate bundle if connecting via private root CA:
# DATABASE_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----\n"

# Firebase mode only: comma-separated administrator email allowlist.
ADMIN_EMAILS=admin@example.com
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_PRIVATE_KEY_CONTENT\n-----END PRIVATE KEY-----\n"
